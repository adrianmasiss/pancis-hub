# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Gemini. Never expose this in client components.
GOOGLE_GENERATIVE_AI_API_KEY=replace-with-google-generative-ai-key
# Modelo "fino": preguntas abiertas, fotos, PDF e InBody. Cuota gratis escasa.
GEMINI_MODEL=gemini-2.5-flash
# Modelo "rapido": explica lo que ya calcularon los motores y da formato.
# Cuota propia; si uno se agota, la app usa el otro (src/lib/ai/google.ts).
GEMINI_MODEL_RAPIDO=gemini-3.1-flash-lite
# Busqueda web (productos, restaurantes). Gratis, solo 2.5-flash acepta Google Search.
GEMINI_MODEL_BUSQUEDA=gemini-2.5-flash

# Pexels (busqueda de fotos de alimentos/recetas, una sola vez al crear).
# Cuenta gratuita en https://www.pexels.com/api/. Never expose this in client components.
PEXELS_API_KEY=replace-with-pexels-api-key

# USDA FoodData Central (biblioteca de alimentos genericos).
# Clave gratuita e inmediata en https://fdc.nal.usda.gov/api-key-signup.html
# Sin esta clave la busqueda en linea sigue funcionando solo con Open Food
# Facts. Never expose this in client components.
USDA_API_KEY=replace-with-usda-api-key

# Open Food Facts no necesita clave ni configuracion: es abierto y gratuito.

# Dietly: optional server-side key. Public reads work without a key.
DIETLY_API_KEY=
